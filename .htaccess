# TSTM — Apache sozlamalari (XAMPP)
#
# ############################################################################
# HOSTINGGA CHIQQANDA YOQING — HTTPS majburiy + HSTS
# ----------------------------------------------------------------------------
# Hozir sayt faqat localhost'da ishlaydi, u yerda HTTPS yo'q — shuning uchun bu
# blok O'CHIRILGAN. Domen ulanib, SSL sertifikat (Let's Encrypt) o'rnatilgach
# quyidagi qatorlardan `#` belgilarini olib tashlang.
#
# 1) Barcha http:// so'rovlarini https:// ga yo'naltirish:
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteCond %{HTTP:X-Forwarded-Proto} !https
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
#
# 2) HSTS — brauzer bu domenga endi HAR DOIM https bilan boradi.
#    DIQQAT: avval HTTPS to'liq ishlayotganiga ishonch hosil qiling. HSTS
#    yoqilgach, sertifikat muddati o'tib ketsa sayt umuman ochilmay qoladi.
#    Dastlab qisqa muddat bilan sinang (max-age=300), hammasi joyida bo'lsa
#    bir yilga (31536000) ko'taring.
# <IfModule mod_headers.c>
#   Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
# </IfModule>
#
# 3) Sessiya cookie'si faqat HTTPS orqali yuborilsin — buni kod avtomatik
#    aniqlaydi (api.php dagi $__https), qo'shimcha sozlash shart emas.
# ############################################################################

# Rasm/ma'lumot hajmi katta bo'lishi mumkin (base64), shuning uchun limitlarni oshiramiz
<IfModule mod_php.c>
  php_value upload_max_filesize 64M
  php_value post_max_size 64M
  php_value memory_limit 256M
</IfModule>
<IfModule mod_php7.c>
  php_value upload_max_filesize 64M
  php_value post_max_size 64M
  php_value memory_limit 256M
</IfModule>
<IfModule mod_php8.c>
  php_value upload_max_filesize 64M
  php_value post_max_size 64M
  php_value memory_limit 256M
</IfModule>

# Ma'lumot fayllarini (parol, xabarlar, login urinishlari) tashqaridan to'g'ridan-to'g'ri
# o'qishni taqiqlash — bularning barchasi faqat api.php orqali (kerakli tekshiruvlar bilan) o'qiladi
<FilesMatch "\.(json)$">
  Require all denied
</FilesMatch>

# Papka tarkibini ro'yxat qilib ko'rsatishni o'chiramiz (masalan /uploads/ ochilganda)
Options -Indexes

# Bosh sahifa. Ilgari `Bosh sahifa - Hi-Fi.html` deb atalardi va `index.php`
# unga yo'naltirardi — natijada manzil `/Bosh%20sahifa%20-%20Hi-Fi.html`
# ko'rinardi va Linux serverda harf registri xatoga olib kelishi mumkin edi
# (Windows registrni farqlamaydi, Linux farqlaydi). 2026-08-10 da fayl
# `index.html` ga o'zgartirildi, yo'naltiruvchi `index.php` esa o'chirildi.
DirectoryIndex index.html index.php

# HTML va PHP keshlanmaydi — sahifadagi o'zgarish va yangi `?v=` raqami
# tashrifchiga DARHOL yetib borishi uchun.
#
# MUHIM: .js va .css bu ro'yxatda ATAYLAB YO'Q. Ilgari ular ham `no-store` olardi
# va natijada har bir sahifa ochilishida 316 KB CSS/JS qayta yuklanardi — ya'ni
# loyihadagi `?v=` versiyalash sxemasi butunlay bekorga ishlardi. Endi ular uzoq
# keshlanadi (quyidagi mod_expires bloki), bu XAVFSIZ: fayl o'zgarganda HTML'dagi
# `?v=` raqami oshadi va brauzer uni YANGI manzil deb biladi.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm|php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  # ---- Xavfsizlik sarlavhalari ----
  #
  # `always` MUHIM: usiz Apache bu sarlavhalarni FAQAT muvaffaqiyatli (2xx/3xx)
  # javoblarga qo'shadi. Xato sahifalari — 404, 403, 500 — ularsiz qolardi
  # (o'lchangan: 200 javobda 3 ta sarlavha, 404 javobda 0 ta). Ya'ni saytdagi
  # istalgan mavjud bo'lmagan manzil himoyasiz sahifa bo'lib qolardi: uni
  # begona saytga iframe qilib joylash mumkin edi (clickjacking) va CSP ham
  # ishlamasdi. Hostingda bu ayniqsa muhim — u yerda 404 sahifalar ko'p
  # so'raladi (skanerlovchi botlar).
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Boshqaruv paneli qidiruv natijalarida CHIQMASIN.
  #
  # NEGA robots.txt yetarli emas: u faqat sahifani O'QISHNI (crawl) to'xtatadi.
  # Agar kimdir admin sahifasiga havola qo'ysa, Google uni o'qimasdan turib ham
  # manzilni natijalarga qo'shib qo'yishi mumkin. `noindex` sarlavhasi esa
  # indeksdan butunlay chiqaradi — bu robots.txt dan kuchliroq chora.
  <FilesMatch "^(admin\.html)$">
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  </FilesMatch>

  # Service worker KESHLANMASIN. U `?v=` versiyasisiz yuklanadi (brauzer uni
  # o'zi boshqaradi), shuning uchun keshlansa yangi versiya kechikib yetadi va
  # bildirishnoma mantig'i eskirgan holicha qolaveradi.
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header unset Expires
  </FilesMatch>

  # Content-Security-Policy — brauzer darajasidagi ikkinchi mudofaa chizig'i.
  # script-src'da 'unsafe-inline' YO'Q (inline skript bloklangan). style-src'da
  # ham 'unsafe-inline' OLIB TASHLANDI (2026-08-03): ommaviy sahifalarning barcha
  # inline uslublari (style="" atributlari va <style> bloklari) tashqi CSS
  # fayllarга yoki .style DOM API'ga ko'chirildi. Endi CSS faqat 'self' va Google
  # Fonts'dan keladi. CSP shuningdek quyidagilarni bloklaydi:
  #   • begona domendan skript yuklash (script-src ro'yxati yopiq)
  #   • inline skript va inline uslub (unsafe-inline yo'q)
  #   • <base> bilan barcha nisbiy havolalarni o'g'irlash (base-uri)
  #   • forma ma'lumotini boshqa saytga yuborish (form-action)
  #   • saytni begona sahifaga iframe qilib joylash — clickjacking (frame-ancestors)
  #   • Flash/plagin obyektlari (object-src none)
  # Ruxsat etilgan tashqi manbalar: Google Fonts, YouTube (video), Google
  # Translate (a11y paneli va admin avto-tarjimasi).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://translate.google.com https://translate.googleapis.com https://www.gstatic.com; style-src 'self' https://fonts.googleapis.com https://www.gstatic.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://img.youtube.com https://i.ytimg.com https://www.google.com https://www.gstatic.com https://fonts.gstatic.com https://translate.googleapis.com; frame-src 'self' https://www.youtube-nocookie.com https://www.youtube.com https://www.google.com; connect-src 'self' https://translate.googleapis.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"

  # Butun sayt (admin panel ham) endi bir xil QAT'IY CSP ostida — style-src'da
  # 'unsafe-inline' YO'Q. admin.html va admin-ui.js ning barcha inline uslublari
  # tashqi admin.css'ga yoki .style DOM API'ga ko'chirildi (2026-08-03).
</IfModule>

# Yashirin / xizmat fayllarini tashqaridan ochishni taqiqlash
<FilesMatch "^\.(htaccess|htpasswd|git)">
  Require all denied
</FilesMatch>
<FilesMatch "\.(md|log|bak|sql|ini)$">
  Require all denied
</FilesMatch>

# Ishlab chiqish papkalari (.idea, .claude, .git, .vscode) — butun papka yopiladi.
# FilesMatch faqat FAYL nomiga qaraydi, shuning uchun `.idea/workspace.xml` ochiq qolgan edi
# (2026-07-28'da topildi: HTTP 200 qaytarardi). RedirectMatch esa to'liq YO'Lni tekshiradi.
# .xml ni umuman bloklab bo'lmaydi — sitemap.xml ochiq qolishi kerak.
RedirectMatch 404 (?i)/\.(idea|claude|git|vscode|env)(/|$)

# Backend ichki fayllari (DB config + seed + maxfiy sozlamalar) — ular faqat
# api.php ichidan (server tomonda) chaqiriladi, tashqaridan to'g'ridan-to'g'ri
# ochib bo'lmaydi (baza login/parolini himoya qilish uchun).
# config.php — baza paroli shu yerda; config.sample.php ham yopiladi, chunki u
# tuzilmani (qaysi kalitlar borligini) oshkor qiladi.
<FilesMatch "^(db|seed|config|config\.sample)\.php$">
  Require all denied
</FilesMatch>

# ############################################################################
# TEZLIK — siqish va brauzer keshi
# ----------------------------------------------------------------------------
# O'lchangan ta'sir: CSS/JS/HTML 316 KB -> 90 KB (72% tejov).
# ############################################################################

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  # Eski brauzerlarning buzuq siqish amalga oshiruvlari (xavfsizlik uchun standart)
  BrowserMatch ^Mozilla/4 gzip-only-text/html
  BrowserMatch ^Mozilla/4\.0[678] no-gzip
  BrowserMatch \bMSIE\s7 !no-gzip !gzip-only-text/html
</IfModule>

# Statik fayllar uzoq keshlanadi. Bu XAVFSIZ, chunki loyihada `?v=` versiyalash
# sxemasi bor: fayl o'zgarganda HTML'dagi raqam oshadi va brauzer uni YANGI
# manzil deb biladi. HTML esa qisqa muddat keshlanadi — yangi versiya raqami
# tashrifchiga darhol yetib borishi uchun.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css               "access plus 1 year"
  # Apache .js ni `text/javascript` deb beradi (`application/javascript` emas) —
  # ikkalasi ham yozilmasa JS fayllar uzoq keshlanmay qoladi.
  ExpiresByType text/javascript        "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png              "access plus 6 months"
  ExpiresByType image/jpeg             "access plus 6 months"
  ExpiresByType image/webp             "access plus 6 months"
  ExpiresByType image/gif              "access plus 6 months"
  ExpiresByType image/svg+xml          "access plus 6 months"
  ExpiresByType text/html              "access plus 10 minutes"
  ExpiresDefault                       "access plus 1 day"
</IfModule>

# api.php javoblari HECH QACHON keshlanmasligi kerak — kontent o'zgarganda
# tashrifchi eski ma'lumotni ko'rmasin. (api.php o'zi ham `Cache-Control:
# no-store` yuboradi; bu qo'shimcha kafolat.)
<IfModule mod_headers.c>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store, must-revalidate"
  </FilesMatch>
</IfModule>
